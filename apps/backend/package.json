{
  "name": "backend",
  "private": true,
  "type": "module",
  "dockerfileType": "node",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "ci": "run-p lint typecheck test:coverage build",
    "clean": "rm -rf build coverage",
    "dev": "NODE_ENV=development tsx watch --env-file=.env src/main.ts",
    "docker:build": "cd ../.. && apps/backend/.ci/docker-build.sh",
    "docker:run": "cd ../.. && apps/backend/.ci/docker-run.sh",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "npm run lint -- --fix",
    "start": "npm run build && NODE_ENV=production node ./build/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@repo/db-schema": "*",
    "@wesp-up/express": "4.0.1",
    "drizzle-orm": "0.44.5",
    "express": "5.1.0",
    "postgres": "3.4.7",
    "prom-client": "15.1.3",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "@types/uuid": "11.0.0",
    "@vitest/coverage-v8": "3.2.4",
    "@wesp-up/eslint-config": "2.1.0",
    "@wesp-up/tsconfig": "2.0.0",
    "eslint": "9.36.0",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
